import Mathlib
import Goldblatt.Ch03_Ultrapower
import Goldblatt.Ch05_GreatAndSmall
import Goldblatt.Ch06_Sequences
import Goldblatt.Ch07_Continuity

/-!
# 10. Topology of the Reals

An open set of real numbers is one that contains, along with each of its points, all points
that are near enough to it. In the hyperreal line "near enough" has a sharp meaning: infinitely
close. This chapter rewrites the elementary topology of the real line in those terms. Each
standard notion, which is defined with a quantifier over positive radii or over open covers,
becomes a statement about the halo of a real point and the enlargement $`{}^*A` of a set
$`A \subseteq \mathbb R`.

* A real number $`r` is interior to $`A` exactly when its halo lies inside $`{}^*A`; it is a
  closure point exactly when its halo meets $`{}^*A`; it is a limit point exactly when its halo
  meets $`{}^*A` in a point other than $`r`.
* A set is open when the enlargement contains the halo of each of its points, and closed when
  the shadow of every limited point of the enlargement belongs to the set.
* A set $`B` is compact exactly when every point of $`{}^*B` is infinitely close to a point of
  $`B`. This is Robinson's criterion; it turns arguments about open covers into arguments about
  single hyperreal points, and the Heine–Borel theorem, the preservation of compactness by
  continuous maps and the uniform continuity of continuous functions on compact sets all become
  short.

Every characterisation is linked to Mathlib's notion ({name}`interior`, {name}`closure`,
{name}`derivedSet`, {name}`IsOpen`, {name}`IsClosed`, {name}`IsCompact`,
{name}`UniformContinuousOn`), so the nonstandard criteria can be used directly on statements
about the real line phrased in Mathlib's language.

The last section looks at the hyperreal line itself, where there is no single best notion of
open set. Three candidates are compared: unions of intervals of real radius, which do not form a
topology; Robinson's S-topology, generated by intervals from which the points infinitely close
to the end points have been removed; and the interval topology, which is the order topology of
the hyperreal line.

Two statements of Section 10.5 are false as printed and are formalized in corrected form, with
the counterexamples proved: the intersection of the real-open sets containing a point is the
point alone and not its halo, and only intervals of limited length are intersections of two
intervals of real radius. The docstrings of the declarations concerned give the details.

## 10.1 Interior, Closure, and Limit Points

The three standard notions are defined with real radii, exactly as in the book, and are shown
to agree with Mathlib's {name}`interior`, {name}`closure` and {name}`derivedSet`. Theorem 10.1.1
then replaces the radii by halos. Part (1) is the permanence principle of Section 7.10. The
book proves part (2) by transfer and deduces part (3) from it; here part (3) is deduced from
part (1) by passing to the complement, because the enlargement of a complement is the complement
of the enlargement, and part (2) is part (3) applied to the set with the point removed.
-/

namespace Goldblatt

open Set Filter Ultrapower
open scoped Hyperreal Topology

section Points

variable {A B : Set ℝ} {r : ℝ}

/-- In an ordered field, the open interval of radius $`e` about $`r` consists of the points at
distance less than $`e` from $`r`. -/
private theorem mem_Ioo_sub_add_iff {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    {r e x : K} : x ∈ Ioo (r - e) (r + e) ↔ |x - r| < e := by
  rw [mem_Ioo, abs_lt]
  constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

/-- **Section 10.1, definition.** The real number $`r` is an _interior point_ of $`A` if
$`(r - e, r + e) \subseteq A` for some real $`e > 0`. -/
def IsInteriorPoint (A : Set ℝ) (r : ℝ) : Prop :=
  ∃ e : ℝ, 0 < e ∧ Ioo (r - e) (r + e) ⊆ A

/-- **Section 10.1, definition.** The real number $`r` is a _closure point_ of $`A` if
$`(r - e, r + e)` meets $`A` for every real $`e > 0`. -/
def IsClosurePoint (A : Set ℝ) (r : ℝ) : Prop :=
  ∀ e : ℝ, 0 < e → (Ioo (r - e) (r + e) ∩ A).Nonempty

/-- **Section 10.1, definition.** The real number $`r` is a _limit point_ of $`A` if for every
real $`e > 0` the interval $`(r - e, r + e)` meets $`A` in a point other than $`r`. -/
def IsLimitPoint (A : Set ℝ) (r : ℝ) : Prop :=
  ∀ e : ℝ, 0 < e → ∃ x ∈ Ioo (r - e) (r + e) ∩ A, x ≠ r

/-- **Section 10.1.** The interior points of $`A` are the members of Mathlib's
{name}`interior` of $`A`. -/
theorem isInteriorPoint_iff_mem_interior : IsInteriorPoint A r ↔ r ∈ interior A := by
  rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff]
  simp only [Real.ball_eq_Ioo]
  exact ⟨fun ⟨e, he, h⟩ => ⟨e, he, h⟩, fun ⟨e, he, h⟩ => ⟨e, he, h⟩⟩

/-- **Section 10.1.** The closure points of $`A` are the members of Mathlib's
{name}`closure` of $`A`. -/
theorem isClosurePoint_iff_mem_closure : IsClosurePoint A r ↔ r ∈ closure A := by
  rw [Metric.mem_closure_iff]
  constructor
  · intro h e he
    obtain ⟨x, hx, hxA⟩ := h e he
    refine ⟨x, hxA, ?_⟩
    rw [Real.dist_eq, abs_sub_comm]
    exact mem_Ioo_sub_add_iff.1 hx
  · intro h e he
    obtain ⟨x, hxA, hx⟩ := h e he
    rw [Real.dist_eq, abs_sub_comm] at hx
    exact ⟨x, mem_Ioo_sub_add_iff.2 hx, hxA⟩

/-- **Section 10.1.** The limit points of $`A` are the members of Mathlib's
{name}`derivedSet` of $`A`, that is, the accumulation points of $`A`. -/
theorem isLimitPoint_iff_mem_derivedSet : IsLimitPoint A r ↔ r ∈ derivedSet A := by
  rw [mem_derivedSet, accPt_iff_nhds]
  constructor
  · intro h U hU
    obtain ⟨e, he, hsub⟩ := Metric.mem_nhds_iff.1 hU
    rw [Real.ball_eq_Ioo] at hsub
    obtain ⟨x, ⟨hx, hxA⟩, hne⟩ := h e he
    exact ⟨x, ⟨hsub hx, hxA⟩, hne⟩
  · intro h e he
    exact h _ (Ioo_mem_nhds (by linarith) (by linarith))

/-- **Section 10.1.** An interior point of $`A` belongs to $`A`: the interior is included in
the set. -/
theorem IsInteriorPoint.mem (h : IsInteriorPoint A r) : r ∈ A := by
  obtain ⟨e, he, hsub⟩ := h
  exact hsub ⟨by linarith, by linarith⟩

/-- **Section 10.1.** Every point of $`A` is a closure point of $`A`: the set is included in
its closure. -/
theorem isClosurePoint_of_mem (h : r ∈ A) : IsClosurePoint A r :=
  fun e he => ⟨r, ⟨by linarith, by linarith⟩, h⟩

/-- **Theorem 10.1.1(1).** A real number $`r` is interior to $`A` if and only if every
hyperreal infinitely close to $`r` belongs to $`{}^*A`, that is,
$`\operatorname{hal}(r) \subseteq {}^*A`. The proof is the permanence argument of Section 7.10:
a neighbourhood of infinitesimal radius inside $`{}^*A` yields one of real radius inside
$`A`. -/
theorem isInteriorPoint_iff_hal_subset : IsInteriorPoint A r ↔ hal (r : ℝ*) ⊆ ⋆A :=
  hal_subset_starSet_iff.symm

/-- **Theorem 10.1.1(1), pointwise form.** $`r` is interior to $`A` if and only if
$`r \simeq x` implies $`x \in {}^*A`. -/
theorem isInteriorPoint_iff_forall_infClose :
    IsInteriorPoint A r ↔ ∀ x : ℝ*, (r : ℝ*) ≊ x → x ∈ ⋆A :=
  isInteriorPoint_iff_hal_subset

/-- **Section 10.1.** A point is a closure point of $`A` exactly when it is not interior to the
complement of $`A`. -/
theorem isClosurePoint_iff_not_isInteriorPoint_compl :
    IsClosurePoint A r ↔ ¬ IsInteriorPoint Aᶜ r := by
  constructor
  · rintro h ⟨e, he, hsub⟩
    obtain ⟨x, hx, hxA⟩ := h e he
    exact hsub hx hxA
  · intro h e he
    by_contra hne
    exact h ⟨e, he, fun x hx hxA => hne ⟨x, hx, hxA⟩⟩

/-- **Theorem 10.1.1(3).** A real number $`r` is a closure point of $`A` if and only if it is
infinitely close to some member of $`{}^*A`. The proof passes to the complement: by part (1),
$`r` fails to be interior to the complement of $`A` exactly when its halo is not included in
$`{}^*(A^c) = ({}^*A)^c`. -/
theorem isClosurePoint_iff_exists_infClose :
    IsClosurePoint A r ↔ ∃ x ∈ ⋆A, (r : ℝ*) ≊ x := by
  rw [isClosurePoint_iff_not_isInteriorPoint_compl, isInteriorPoint_iff_hal_subset,
    starSet_compl, Set.not_subset]
  simp only [mem_hal, mem_compl_iff, not_not]
  exact ⟨fun ⟨x, h1, h2⟩ => ⟨x, h2, h1⟩, fun ⟨x, h1, h2⟩ => ⟨x, h2, h1⟩⟩

/-- **Theorem 10.1.1(3), halo form.** $`r` is a closure point of $`A` if and only if
$`\operatorname{hal}(r) \cap {}^*A` is nonempty. -/
theorem isClosurePoint_iff_hal_inter_nonempty :
    IsClosurePoint A r ↔ (hal (r : ℝ*) ∩ ⋆A).Nonempty := by
  rw [isClosurePoint_iff_exists_infClose]
  exact ⟨fun ⟨x, h1, h2⟩ => ⟨x, h2, h1⟩, fun ⟨x, h1, h2⟩ => ⟨x, h2, h1⟩⟩

/-- **Section 10.1.** A limit point of $`A` at $`r` is a closure point of $`A` with $`r`
removed. -/
theorem isLimitPoint_iff_isClosurePoint_diff :
    IsLimitPoint A r ↔ IsClosurePoint (A \ {r}) r := by
  constructor
  · intro h e he
    obtain ⟨x, ⟨hx, hxA⟩, hne⟩ := h e he
    exact ⟨x, hx, hxA, hne⟩
  · intro h e he
    obtain ⟨x, hx, hxA, hne⟩ := h e he
    exact ⟨x, ⟨hx, hxA⟩, hne⟩

/-- **Theorem 10.1.1(2).** A real number $`r` is a limit point of $`A` if and only if there is
a hyperreal $`x \ne r` with $`r \simeq x \in {}^*A`. This is part (3) for the set
$`A \setminus \{r\}`, whose enlargement is $`{}^*A \setminus \{r\}`. -/
theorem isLimitPoint_iff_exists_infClose :
    IsLimitPoint A r ↔ ∃ x ∈ ⋆A, x ≠ (r : ℝ*) ∧ (r : ℝ*) ≊ x := by
  rw [isLimitPoint_iff_isClosurePoint_diff, isClosurePoint_iff_exists_infClose, starSet_diff,
    starSet_singleton_real]
  exact ⟨fun ⟨x, ⟨hx, hne⟩, h⟩ => ⟨x, hx, hne, h⟩, fun ⟨x, hx, hne, h⟩ => ⟨x, ⟨hx, hne⟩, h⟩⟩

/-- **Theorem 10.1.1(2), halo form.** $`r` is a limit point of $`A` if and only if
$`\operatorname{hal}(r) \cap {}^*A` contains a point other than $`r`. -/
theorem isLimitPoint_iff_exists_mem_hal_inter :
    IsLimitPoint A r ↔ ∃ x ∈ hal (r : ℝ*) ∩ ⋆A, x ≠ (r : ℝ*) := by
  rw [isLimitPoint_iff_exists_infClose]
  exact ⟨fun ⟨x, h1, h2, h3⟩ => ⟨x, ⟨h3, h1⟩, h2⟩, fun ⟨x, ⟨h3, h1⟩, h2⟩ => ⟨x, h1, h2, h3⟩⟩

/-- **Section 10.1.** The closure of $`A` is the union of $`A` and its derived set: $`r` is a
closure point of $`A` if and only if it belongs to $`A` or is a limit point of $`A`. The proof
is the book's argument for Theorem 10.1.1(3): a point of $`{}^*A` infinitely close to $`r` is
either $`r` itself, and then $`r \in {}^*A \cap \mathbb R = A`, or different from $`r`. -/
theorem isClosurePoint_iff_mem_or_isLimitPoint :
    IsClosurePoint A r ↔ r ∈ A ∨ IsLimitPoint A r := by
  rw [isClosurePoint_iff_exists_infClose, isLimitPoint_iff_exists_infClose]
  constructor
  · rintro ⟨x, hx, hrx⟩
    by_cases h : x = (r : ℝ*)
    · exact Or.inl (coe_mem_starSet.1 (h ▸ hx))
    · exact Or.inr ⟨x, hx, h, hrx⟩
  · rintro (h | ⟨x, hx, -, hrx⟩)
    · exact ⟨r, coe_mem_starSet.2 h, InfClose.refl _⟩
    · exact ⟨x, hx, hrx⟩

/-- **Section 10.1, non-vacuity.** The three notions differ: $`0` is a limit point and a
closure point of the open interval $`(0, 1)` without being an interior point, or even a
member. -/
theorem isLimitPoint_zero_Ioo :
    IsLimitPoint (Ioo (0 : ℝ) 1) 0 ∧ IsClosurePoint (Ioo (0 : ℝ) 1) 0 ∧
      ¬ IsInteriorPoint (Ioo (0 : ℝ) 1) 0 := by
  have hl : IsLimitPoint (Ioo (0 : ℝ) 1) 0 := by
    rw [isLimitPoint_iff_exists_infClose]
    refine ⟨ε, ?_, epsilon_pos_infinitesimal.1.ne', (infinitesimal_iff_infClose_zero.1
      infinitesimal_epsilon).symm⟩
    rw [starSet_Ioo_real]
    exact ⟨epsilon_pos_infinitesimal.1, epsilon_pos_infinitesimal.2 1 one_pos⟩
  exact ⟨hl, isClosurePoint_iff_mem_or_isLimitPoint.2 (Or.inr hl), fun h => by simpa using h.mem⟩

end Points

/-!
## 10.2 Open and Closed Sets

A set is open when all its points are interior and closed when it contains all its closure
points, equivalently all its limit points. Combined with Theorem 10.1.1 this gives the two
working criteria of the chapter: $`A` is open when $`{}^*A` contains the halo of every point of
$`A`, and closed when every real number infinitely close to a point of $`{}^*A` is in $`A`.
The algebra of open and closed sets (Theorem 10.2.1) is then read off from the way
enlargement commutes with complements, finite intersections and finite unions; the
declarations whose names end in {lit}`by_halos` reprove facts that Mathlib already has, by the
book's arguments. Theorem 10.2.2 recovers the halo of a real point from the open sets alone.
-/

section OpenClosed

variable {A B : Set ℝ} {r : ℝ}

/-- **Section 10.2, definition.** A set is open if and only if all its points are interior to
it. This identifies the book's definition with Mathlib's {name}`IsOpen`. -/
theorem isOpen_iff_forall_isInteriorPoint : IsOpen A ↔ ∀ r ∈ A, IsInteriorPoint A r := by
  simp only [isInteriorPoint_iff_mem_interior]
  rw [← subset_interior_iff_isOpen]
  rfl

/-- **Section 10.2, definition.** A set is closed if and only if it contains all its closure
points. This identifies the book's definition with Mathlib's {name}`IsClosed`. -/
theorem isClosed_iff_forall_isClosurePoint : IsClosed A ↔ ∀ r, IsClosurePoint A r → r ∈ A := by
  simp only [isClosurePoint_iff_mem_closure]
  rw [← closure_subset_iff_isClosed]
  rfl

/-- **Section 10.2.** A set is closed if and only if it contains all its limit points. -/
theorem isClosed_iff_forall_isLimitPoint : IsClosed A ↔ ∀ r, IsLimitPoint A r → r ∈ A := by
  rw [isClosed_iff_forall_isClosurePoint]
  refine forall_congr' fun r => ?_
  rw [isClosurePoint_iff_mem_or_isLimitPoint]
  exact ⟨fun h hl => h (Or.inr hl), fun h => fun hh => hh.elim id h⟩

/-- **Section 10.2, nonstandard criterion for open sets.** $`A` is open if and only if for
every $`r \in A`, every hyperreal infinitely close to $`r` belongs to $`{}^*A`. -/
theorem isOpen_iff_forall_hal_subset : IsOpen A ↔ ∀ r ∈ A, hal (r : ℝ*) ⊆ ⋆A := by
  rw [isOpen_iff_forall_isInteriorPoint]
  exact forall₂_congr fun r _ => isInteriorPoint_iff_hal_subset

/-- **Section 10.2, nonstandard criterion for closed sets.** $`A` is closed if and only if
every real number that is infinitely close to some member of $`{}^*A` belongs to $`A`. -/
theorem isClosed_iff_forall_infClose :
    IsClosed A ↔ ∀ r : ℝ, ∀ x ∈ ⋆A, (r : ℝ*) ≊ x → r ∈ A := by
  rw [isClosed_iff_forall_isClosurePoint]
  refine forall_congr' fun r => ?_
  rw [isClosurePoint_iff_exists_infClose]
  exact ⟨fun h x hx hrx => h ⟨x, hx, hrx⟩, fun h ⟨x, hx, hrx⟩ => h x hx hrx⟩

/-- **Section 10.2, shadow form of the criterion for closed sets.** $`A` is closed if and only
if the shadow of every limited member of $`{}^*A` belongs to $`A`. -/
theorem isClosed_iff_forall_sh_mem : IsClosed A ↔ ∀ x ∈ ⋆A, Limited x → sh x ∈ A := by
  rw [isClosed_iff_forall_infClose]
  constructor
  · intro h x hx hl
    exact h (sh x) x hx hl.infClose_sh.symm
  · intro h r x hx hrx
    have := h x hx (limited_of_infClose_coe hrx.symm)
    rwa [sh_eq_of_infClose hrx.symm] at this

/-- **Theorem 10.2.1(1), nonstandard core.** The halo criterion for $`A` to be open is
equivalent to the infinite-closeness criterion for the complement of $`A` to be closed. Both
directions use only that $`x \in {}^*(A^c)` if and only if $`x \notin {}^*A`. -/
theorem forall_hal_subset_iff_compl :
    (∀ r ∈ A, hal (r : ℝ*) ⊆ ⋆A) ↔ ∀ r : ℝ, ∀ x ∈ ⋆(Aᶜ), (r : ℝ*) ≊ x → r ∈ Aᶜ := by
  constructor
  · intro h r x hx hrx hr
    rw [starSet_compl] at hx
    exact hx (h r hr hrx)
  · intro h r hr x hrx
    by_contra hx
    have hx' : x ∈ ⋆(Aᶜ) := by rw [starSet_compl]; exact hx
    exact h r x hx' hrx hr

/-- **Theorem 10.2.1(1).** A set of real numbers is open if and only if its complement is
closed. Mathlib has this as {name}`isClosed_compl_iff`; the proof here is the book's, through
the two nonstandard criteria. -/
theorem isOpen_iff_isClosed_compl_by_halos : IsOpen A ↔ IsClosed Aᶜ := by
  rw [isOpen_iff_forall_hal_subset, isClosed_iff_forall_infClose]
  exact forall_hal_subset_iff_compl

/-- **Theorem 10.2.1(2), binary intersections.** The intersection of two open sets is open: if
$`x \simeq r \in A \cap B` then $`x \in {}^*A \cap {}^*B = {}^*(A \cap B)`. -/
theorem isOpen_inter_by_halos (hA : IsOpen A) (hB : IsOpen B) : IsOpen (A ∩ B) := by
  rw [isOpen_iff_forall_hal_subset] at *
  intro r hr x hx
  rw [starSet_inter]
  exact ⟨hA r hr.1 hx, hB r hr.2 hx⟩

/-- **Theorem 10.2.1(2), finite intersections.** The intersection of finitely many open sets is
open, because enlargement commutes with finite intersections. -/
theorem isOpen_iInter_by_halos {ι : Type*} [Finite ι] {A : ι → Set ℝ} (h : ∀ i, IsOpen (A i)) :
    IsOpen (⋂ i, A i) := by
  rw [isOpen_iff_forall_hal_subset]
  intro r hr x hx
  rw [starSet_iInter_of_finite]
  exact mem_iInter.2 fun i => isOpen_iff_forall_hal_subset.1 (h i) r (mem_iInter.1 hr i) hx

/-- **Theorem 10.2.1(2), arbitrary unions.** The union of any family of open sets is open: if
$`x \simeq r \in A_j` then $`x \in {}^*A_j \subseteq {}^*(\bigcup_i A_i)`. -/
theorem isOpen_iUnion_by_halos {ι : Sort*} {A : ι → Set ℝ} (h : ∀ i, IsOpen (A i)) :
    IsOpen (⋃ i, A i) := by
  rw [isOpen_iff_forall_hal_subset]
  intro r hr x hx
  obtain ⟨j, hj⟩ := mem_iUnion.1 hr
  exact starSet_mono (subset_iUnion A j) (isOpen_iff_forall_hal_subset.1 (h j) r hj hx)

/-- **Theorem 10.2.1(3), binary unions.** The union of two closed sets is closed: a point of
$`{}^*(A \cup B) = {}^*A \cup {}^*B` infinitely close to a real $`r` lies in $`{}^*A` or in
$`{}^*B`, and $`r` is then in $`A` or in $`B`. -/
theorem isClosed_union_by_halos (hA : IsClosed A) (hB : IsClosed B) : IsClosed (A ∪ B) := by
  rw [isClosed_iff_forall_infClose] at *
  intro r x hx hrx
  rw [starSet_union] at hx
  exact hx.elim (fun h => Or.inl (hA r x h hrx)) fun h => Or.inr (hB r x h hrx)

/-- **Theorem 10.2.1(3), finite unions.** The union of finitely many closed sets is closed,
because enlargement commutes with finite unions. -/
theorem isClosed_iUnion_by_halos {ι : Type*} [Finite ι] {A : ι → Set ℝ}
    (h : ∀ i, IsClosed (A i)) : IsClosed (⋃ i, A i) := by
  rw [isClosed_iff_forall_infClose]
  intro r x hx hrx
  rw [starSet_iUnion_of_finite] at hx
  obtain ⟨i, hi⟩ := mem_iUnion.1 hx
  exact mem_iUnion.2 ⟨i, isClosed_iff_forall_infClose.1 (h i) r x hi hrx⟩

/-- **Theorem 10.2.1(3), arbitrary intersections.** The intersection of any family of closed
sets is closed: $`{}^*(\bigcap_i A_i) \subseteq {}^*A_i` for each $`i`. -/
theorem isClosed_iInter_by_halos {ι : Sort*} {A : ι → Set ℝ} (h : ∀ i, IsClosed (A i)) :
    IsClosed (⋂ i, A i) := by
  rw [isClosed_iff_forall_infClose]
  intro r x hx hrx
  exact mem_iInter.2 fun i =>
    isClosed_iff_forall_infClose.1 (h i) r x (starSet_mono (iInter_subset A i) hx) hrx

/-- **Theorem 10.2.2.** The halo of a real number $`r` is the intersection of the enlargements
of the open sets containing $`r`:
$$`\operatorname{hal}(r) = \bigcap \{{}^*A : r \in A \text{ and } A \text{ is open}\}.`
A point outside the halo is at distance at least some real $`e > 0` from $`r`, and so lies
outside the enlargement of $`(r - e, r + e)`. -/
theorem hal_coe_eq_iInter_starSet_isOpen (r : ℝ) :
    hal (r : ℝ*) = ⋂ (A : Set ℝ) (_ : r ∈ A) (_ : IsOpen A), ⋆A := by
  apply Subset.antisymm
  · intro x hx
    simp only [mem_iInter]
    exact fun A hr hA => isOpen_iff_forall_hal_subset.1 hA r hr hx
  · intro x hx
    simp only [mem_iInter] at hx
    by_contra hne
    rw [mem_hal, infClose_iff_abs_lt] at hne
    push Not at hne
    obtain ⟨e, he, hle⟩ := hne
    have hx' := hx (Ioo (r - e) (r + e)) ⟨by linarith, by linarith⟩ isOpen_Ioo
    rw [starSet_Ioo_real, Hyperreal.coe_sub, Hyperreal.coe_add, mem_Ioo_sub_add_iff,
      abs_sub_comm] at hx'
    exact absurd hx' (not_lt.2 hle)

/-- **Exercise 10.2.3.** Enlargement does not commute with infinite intersections, so the
proof of Theorem 10.2.1(2) does not extend to them:
$$`{}^*\Bigl(\bigcap_{n} \bigl(-\tfrac1n, \tfrac1n\bigr)\Bigr) \ne
  \bigcap_{n} {}^*\bigl(-\tfrac1n, \tfrac1n\bigr).`
The left side is $`\{0\}`, while the right side contains the infinitesimal $`\varepsilon`.
The intervals are indexed from $`0` as $`(-\frac1{n+1}, \frac1{n+1})`. -/
theorem starSet_iInter_Ioo_ne_iInter_starSet :
    (⋆(⋂ n : ℕ, Ioo (-(1 / ((n : ℝ) + 1))) (1 / ((n : ℝ) + 1))) : Set ℝ*) ≠
      ⋂ n : ℕ, ⋆(Ioo (-(1 / ((n : ℝ) + 1))) (1 / ((n : ℝ) + 1))) := by
  intro h
  have hε : (ε : ℝ*) ∈ ⋂ n : ℕ, ⋆(Ioo (-(1 / ((n : ℝ) + 1))) (1 / ((n : ℝ) + 1))) := by
    refine mem_iInter.2 fun n => ?_
    have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    rw [starSet_Ioo_real]
    refine ⟨lt_trans ?_ epsilon_pos_infinitesimal.1, epsilon_pos_infinitesimal.2 _ hpos⟩
    rw [Hyperreal.coe_neg, neg_lt_zero]
    exact Hyperreal.coe_pos.2 hpos
  rw [← h] at hε
  have hsub : (⋂ n : ℕ, Ioo (-(1 / ((n : ℝ) + 1))) (1 / ((n : ℝ) + 1))) ⊆ ({0} : Set ℝ) := by
    intro x hx
    by_contra hx0
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt (abs_pos.2 hx0)
    have := mem_iInter.1 hx n
    exact absurd (abs_lt.2 this) (not_lt.2 hn.le)
  have := starSet_mono (αS := ℝ*) hsub hε
  rw [starSet_singleton_real] at this
  exact epsilon_pos_infinitesimal.1.ne' this

end OpenClosed

/-!
## 10.3 Compactness

A set of real numbers is compact when every cover of it by open sets has a finite subcover.
Robinson's criterion replaces the covers by a condition on points: $`B` is compact exactly
when every member of $`{}^*B` is infinitely close to a member of $`B`. The condition is given
the name {lit}`RobinsonCompact` so that the book's elementary observations about it (closed
intervals and finite sets satisfy it, the interval $`(0, 1)` does not, a set satisfying it is
bounded and closed) can be stated and proved by reasoning about hyperreal points alone. The
criterion itself is then proved against Mathlib's {name}`IsCompact`, and the Heine–Borel
theorem follows from the observations.
-/

section Compactness

variable {B C : Set ℝ}

/-- **Section 10.3, Robinson's compactness criterion (the condition).** Every member of
$`{}^*B` is infinitely close to some member of $`B`. -/
def RobinsonCompact (B : Set ℝ) : Prop :=
  ∀ x ∈ ⋆B, ∃ r ∈ B, x ≊ (r : ℝ*)

/-- **Section 10.3.** Robinson's condition says that the halos of the points of $`B` cover the
enlargement: $`{}^*B \subseteq \bigcup_{r \in B} \operatorname{hal}(r)`. -/
theorem robinsonCompact_iff_starSet_subset_iUnion_hal :
    RobinsonCompact B ↔ ⋆B ⊆ ⋃ r ∈ B, hal (r : ℝ*) := by
  constructor
  · intro h x hx
    obtain ⟨r, hr, hxr⟩ := h x hx
    exact mem_iUnion₂.2 ⟨r, hr, hxr.symm⟩
  · intro h x hx
    obtain ⟨r, hr, hxr⟩ := mem_iUnion₂.1 (h hx)
    exact ⟨r, hr, InfClose.symm hxr⟩

/-- **Section 10.3.** Since the only real number a hyperreal can be infinitely close to is its
shadow, Robinson's condition says: every $`x \in {}^*B` is limited and
$`\operatorname{sh}(x) \in B`. -/
theorem robinsonCompact_iff_limited_sh_mem :
    RobinsonCompact B ↔ ∀ x ∈ ⋆B, Limited x ∧ sh x ∈ B := by
  constructor
  · intro h x hx
    obtain ⟨r, hr, hxr⟩ := h x hx
    exact ⟨limited_of_infClose_coe hxr, by rwa [sh_eq_of_infClose hxr]⟩
  · intro h x hx
    exact ⟨sh x, (h x hx).2, (h x hx).1.infClose_sh⟩

/-- **Section 10.3, first example.** The open interval $`(0, 1)` does not satisfy Robinson's
condition: the positive infinitesimal $`\varepsilon` belongs to $`{}^*(0, 1)`, but its shadow
$`0` does not belong to $`(0, 1)`. -/
theorem not_robinsonCompact_Ioo_zero_one : ¬ RobinsonCompact (Ioo (0 : ℝ) 1) := by
  intro h
  have hε : (ε : ℝ*) ∈ ⋆(Ioo (0 : ℝ) 1) := by
    rw [starSet_Ioo_real]
    exact ⟨epsilon_pos_infinitesimal.1, epsilon_pos_infinitesimal.2 1 one_pos⟩
  have hsh := (robinsonCompact_iff_limited_sh_mem.1 h _ hε).2
  rw [sh_eq_of_infClose (c := 0) (infinitesimal_iff_infClose_zero.1 infinitesimal_epsilon)] at hsh
  exact lt_irrefl _ hsh.1

/-- **Section 10.3, second example.** Every closed interval $`[a, b]` satisfies Robinson's
condition: a point $`x` of $`{}^*[a, b]` satisfies $`a \le x \le b`, so it is limited and its
shadow lies in $`[a, b]`. -/
theorem robinsonCompact_Icc (a b : ℝ) : RobinsonCompact (Icc a b) := fun x hx =>
  ⟨sh x, (infClose_sh_of_mem_starSet_Icc hx).2, (infClose_sh_of_mem_starSet_Icc hx).1⟩

/-- **Section 10.3, third example.** Every finite set satisfies Robinson's condition: the
enlargement of a finite set is the set itself, and each of its members is infinitely close to
itself. -/
theorem robinsonCompact_of_finite (hB : B.Finite) : RobinsonCompact B := by
  intro x hx
  rw [starSet_of_finite_real hB] at hx
  obtain ⟨r, hr, rfl⟩ := hx
  exact ⟨r, hr, InfClose.refl _⟩

/-- **Section 10.3, fourth example.** A set that is unbounded above does not satisfy
Robinson's condition: choosing $`y_n \in B` with $`y_n > n` gives a member $`[y_n]` of
$`{}^*B` that exceeds every real number, so is unlimited and not infinitely close to any real
number. The book obtains the unlimited member by transfer; here it is exhibited as the class
of a sequence. -/
theorem not_robinsonCompact_of_not_bddAbove (h : ¬ BddAbove B) : ¬ RobinsonCompact B := by
  intro hB
  rw [not_bddAbove_iff] at h
  choose y hyB hy using fun n : ℕ => h n
  obtain ⟨r, -, hr⟩ := hB (Hyperreal.ofSeq y)
    (hyperreal_ofSeq_mem_starSet.2 (Eventually.of_forall hyB))
  obtain ⟨-, s, -, hs⟩ := limited_of_infClose_coe hr
  have hy' : Tendsto y atTop atTop :=
    tendsto_atTop_mono (fun n => (hy n).le) tendsto_natCast_atTop_atTop
  exact lt_asymm hs (coe_lt_ofSeq_of_tendsto_atTop hy' s)

/-- **Section 10.3, fourth example, below.** A set that is unbounded below does not satisfy
Robinson's condition. -/
theorem not_robinsonCompact_of_not_bddBelow (h : ¬ BddBelow B) : ¬ RobinsonCompact B := by
  intro hB
  rw [not_bddBelow_iff] at h
  choose y hyB hy using fun n : ℕ => h (-(n : ℝ))
  obtain ⟨r, -, hr⟩ := hB (Hyperreal.ofSeq y)
    (hyperreal_ofSeq_mem_starSet.2 (Eventually.of_forall hyB))
  obtain ⟨s, -, hs, -⟩ := limited_of_infClose_coe hr
  have hy' : Tendsto (fun n => -y n) atTop atTop :=
    tendsto_atTop_mono (fun n => by linarith [hy n]) tendsto_natCast_atTop_atTop
  have h1 := coe_lt_ofSeq_of_tendsto_atTop hy' (-s)
  have h2 : (Hyperreal.ofSeq fun n => -y n) = -Hyperreal.ofSeq y := rfl
  rw [h2, Hyperreal.coe_neg, neg_lt_neg_iff] at h1
  exact lt_asymm hs h1

/-- **Section 10.3.** A set satisfying Robinson's condition is bounded above. -/
theorem RobinsonCompact.bddAbove (hB : RobinsonCompact B) : BddAbove B :=
  by_contra fun h => not_robinsonCompact_of_not_bddAbove h hB

/-- **Section 10.3.** A set satisfying Robinson's condition is bounded below. -/
theorem RobinsonCompact.bddBelow (hB : RobinsonCompact B) : BddBelow B :=
  by_contra fun h => not_robinsonCompact_of_not_bddBelow h hB

/-- **Section 10.3, fifth example.** A set satisfying Robinson's condition is closed: if the
real number $`r` is infinitely close to $`x \in {}^*B`, then the member of $`B` that $`x` is
infinitely close to can only be $`r`. -/
theorem RobinsonCompact.isClosed (hB : RobinsonCompact B) : IsClosed B := by
  rw [isClosed_iff_forall_infClose]
  intro r x hx hrx
  obtain ⟨s, hs, hxs⟩ := hB x hx
  rwa [infClose_coe_iff.1 (hrx.trans hxs)]

/-- The enlargement of a union over a finite set of indices is the union of the
enlargements. -/
private theorem starSet_biUnion_finset' {ι : Type*} (t : Finset ι) (U : ι → Set ℝ) :
    (⋆(⋃ i ∈ t, U i) : Set ℝ*) = ⋃ i ∈ t, ⋆(U i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simp [starSet_empty]
  | insert i t _ ih => rw [Finset.set_biUnion_insert, Finset.set_biUnion_insert, starSet_union, ih]

/-- **Robinson's compactness criterion, first half.** A compact set satisfies Robinson's
condition. Suppose $`b \in {}^*B` is not infinitely close to any member of $`B`. Each
$`r \in B` then has a real $`e_r > 0` with $`|b - r| \ge e_r`, and the intervals
$`(r - e_r, r + e_r)` form an open cover of $`B`. If finitely many of them covered $`B`, their
enlargements would cover $`{}^*B`, and $`b` would satisfy $`|b - r| < e_r` for one of them. -/
theorem _root_.IsCompact.robinsonCompact (hB : IsCompact B) : RobinsonCompact B := by
  intro b hb
  by_contra hcon
  push Not at hcon
  have key : ∀ r : B, ∃ e : ℝ, 0 < e ∧ (e : ℝ*) ≤ |b - (r : ℝ)| := by
    intro r
    have := hcon r r.2
    rw [infClose_iff_abs_lt] at this
    push Not at this
    exact this
  choose e he hle using key
  obtain ⟨t, ht⟩ := hB.elim_finite_subcover (fun r : B => Ioo ((r : ℝ) - e r) (r + e r))
    (fun r => isOpen_Ioo)
    (fun r hr => mem_iUnion.2 ⟨⟨r, hr⟩, by simp [he]⟩)
  have hb' := starSet_mono (αS := ℝ*) ht hb
  rw [starSet_biUnion_finset'] at hb'
  obtain ⟨r, -, hr⟩ := mem_iUnion₂.1 hb'
  rw [starSet_Ioo_real, Hyperreal.coe_sub, Hyperreal.coe_add, mem_Ioo_sub_add_iff] at hr
  exact absurd hr (not_lt.2 (hle r))

/-- **Robinson's compactness criterion, second half.** A set satisfying Robinson's condition
is compact. Given an open cover with no finite subcover, pass to a countable subcover
$`U_0, U_1, \dots` (the book does this with intervals having rational end points; here it is
the Lindelöf property of the real line from Mathlib). For each $`k` there is $`x_k \in B`
outside $`U_0 \cup \dots \cup U_k`. The point $`x = [x_k]` of $`{}^*B` is infinitely close to
some $`r \in B`; this $`r` lies in some $`U_n`, and since $`U_n` is open, $`x \in {}^*U_n`.
So $`x_k \in U_n` for almost all $`k`, contradicting the choice of $`x_k` for $`k \ge n`. The
class of the sequence plays the part of the witness that the book obtains by transfer at an
unlimited index. -/
theorem RobinsonCompact.isCompact (hB : RobinsonCompact B) : IsCompact B := by
  classical
  rw [isCompact_iff_finite_subcover]
  intro ι U hU hcov
  obtain ⟨T, hT, hTU⟩ := TopologicalSpace.isOpen_iUnion_countable U hU
  rcases T.eq_empty_or_nonempty with rfl | hne
  · refine ⟨∅, hcov.trans ?_⟩
    rw [← hTU]
    simp
  obtain ⟨f, rfl⟩ := hT.exists_eq_range hne
  by_contra hno
  push Not at hno
  have key : ∀ k : ℕ, ∃ x ∈ B, ∀ n ≤ k, x ∉ U (f n) := by
    intro k
    obtain ⟨x, hx, hxU⟩ := Set.not_subset.1 (hno ((Finset.range (k + 1)).image f))
    refine ⟨x, hx, fun n hn hmem => hxU ?_⟩
    exact mem_iUnion₂.2
      ⟨f n, Finset.mem_image_of_mem f (Finset.mem_range.2 (Nat.lt_succ_of_le hn)), hmem⟩
  choose x hxB hx using key
  obtain ⟨r, hrB, hxr⟩ := hB (Hyperreal.ofSeq x)
    (hyperreal_ofSeq_mem_starSet.2 (Eventually.of_forall hxB))
  have hr : r ∈ ⋃ i ∈ range f, U i := by
    rw [hTU]
    exact hcov hrB
  obtain ⟨_, ⟨n, rfl⟩, hrn⟩ := mem_iUnion₂.1 hr
  have hmem : Hyperreal.ofSeq x ∈ ⋆(U (f n)) :=
    isOpen_iff_forall_hal_subset.1 (hU (f n)) r hrn hxr.symm
  rw [hyperreal_ofSeq_mem_starSet] at hmem
  have hge : ∀ᶠ k in hyperfilter ℕ, n ≤ k :=
    eventually_hyperfilter_of_eventually_atTop (eventually_ge_atTop n)
  obtain ⟨k, hk1, hk2⟩ := (hmem.and hge).exists
  exact hx k n hk2 hk1

/-- **Robinson's compactness criterion.** A set $`B` of real numbers is compact if and only if
every member of $`{}^*B` is infinitely close to some member of $`B`. -/
theorem isCompact_iff_robinsonCompact : IsCompact B ↔ RobinsonCompact B :=
  ⟨IsCompact.robinsonCompact, RobinsonCompact.isCompact⟩

/-- **Robinson's compactness criterion, written out.** $`B` is compact if and only if every
$`x \in {}^*B` satisfies $`x \simeq r` for some $`r \in B`. -/
theorem isCompact_iff_forall_exists_infClose :
    IsCompact B ↔ ∀ x ∈ ⋆B, ∃ r ∈ B, x ≊ (r : ℝ*) :=
  isCompact_iff_robinsonCompact

/-- **Robinson's compactness criterion, halo form.** $`B` is compact if and only if
$`{}^*B \subseteq \bigcup_{r \in B} \operatorname{hal}(r)`. -/
theorem isCompact_iff_starSet_subset_iUnion_hal :
    IsCompact B ↔ ⋆B ⊆ ⋃ r ∈ B, hal (r : ℝ*) :=
  isCompact_iff_robinsonCompact.trans robinsonCompact_iff_starSet_subset_iUnion_hal

/-- **Robinson's compactness criterion, shadow form.** $`B` is compact if and only if every
$`x \in {}^*B` is limited with $`\operatorname{sh}(x) \in B`. -/
theorem isCompact_iff_forall_limited_sh_mem :
    IsCompact B ↔ ∀ x ∈ ⋆B, Limited x ∧ sh x ∈ B :=
  isCompact_iff_robinsonCompact.trans robinsonCompact_iff_limited_sh_mem

/-- **Section 10.3.** The open interval $`(0, 1)` is not compact. -/
theorem not_isCompact_Ioo_zero_one : ¬ IsCompact (Ioo (0 : ℝ) 1) := fun h =>
  not_robinsonCompact_Ioo_zero_one h.robinsonCompact

/-- **Section 10.3.** Every closed interval $`[a, b]` is compact (the original Heine–Borel
theorem), by Robinson's criterion. -/
theorem isCompact_Icc_by_halos (a b : ℝ) : IsCompact (Icc a b) :=
  (robinsonCompact_Icc a b).isCompact

/-- **Section 10.3.** Every finite set is compact, by Robinson's criterion. -/
theorem isCompact_of_finite_by_halos (hB : B.Finite) : IsCompact B :=
  (robinsonCompact_of_finite hB).isCompact

/-- **Section 10.3.** A compact set of real numbers is bounded above and below, by Robinson's
criterion. -/
theorem bddAbove_and_bddBelow_of_isCompact (hB : IsCompact B) : BddAbove B ∧ BddBelow B :=
  ⟨hB.robinsonCompact.bddAbove, hB.robinsonCompact.bddBelow⟩

/-- **Section 10.3.** A compact set of real numbers is closed, by Robinson's criterion. -/
theorem isClosed_of_isCompact_by_halos (hB : IsCompact B) : IsClosed B :=
  hB.robinsonCompact.isClosed

/-- **Theorem 10.3.1 (Heine–Borel), for Robinson's condition.** A set satisfies Robinson's
condition if and only if it is closed and bounded above and below. For the converse, if
$`B \subseteq [l, u]` then $`{}^*B \subseteq {}^*[l, u]`, so every $`x \in {}^*B` is limited,
and its shadow is in $`B` because $`B` is closed. -/
theorem robinsonCompact_iff_isClosed_and_bdd :
    RobinsonCompact B ↔ IsClosed B ∧ BddAbove B ∧ BddBelow B := by
  refine ⟨fun h => ⟨h.isClosed, h.bddAbove, h.bddBelow⟩, ?_⟩
  rintro ⟨hc, ⟨u, hu⟩, ⟨l, hl⟩⟩
  rw [robinsonCompact_iff_limited_sh_mem]
  intro x hx
  have hsub : B ⊆ Icc l u := fun y hy => ⟨hl hy, hu hy⟩
  have hx' := infClose_sh_of_mem_starSet_Icc (starSet_mono (αS := ℝ*) hsub hx)
  have hlim : Limited x := limited_of_infClose_coe hx'.1
  exact ⟨hlim, isClosed_iff_forall_sh_mem.1 hc x hx hlim⟩

/-- **Theorem 10.3.1 (Heine–Borel).** A set $`B` of real numbers is compact if and only if it
is closed and bounded, that is, $`|x| \le b` for all $`x \in B` for some real $`b`. -/
theorem isCompact_iff_isClosed_and_bounded :
    IsCompact B ↔ IsClosed B ∧ ∃ b : ℝ, ∀ x ∈ B, |x| ≤ b := by
  rw [isCompact_iff_robinsonCompact, robinsonCompact_iff_isClosed_and_bdd]
  refine and_congr_right fun _ => ⟨?_, ?_⟩
  · rintro ⟨⟨u, hu⟩, ⟨l, hl⟩⟩
    refine ⟨max |u| |l|, fun x hx => abs_le.2 ⟨?_, ?_⟩⟩
    · have := hl hx
      have := neg_abs_le l
      have := le_max_right |u| |l|
      linarith
    · have := hu hx
      have := le_abs_self u
      have := le_max_left |u| |l|
      linarith
  · rintro ⟨b, hb⟩
    exact ⟨⟨b, fun x hx => (abs_le.1 (hb x hx)).2⟩, ⟨-b, fun x hx => (abs_le.1 (hb x hx)).1⟩⟩

/-- **Theorem 10.3.1 (Heine–Borel), in Mathlib's vocabulary.** A set of real numbers is compact
if and only if it is closed and bounded in the sense of {name}`Bornology.IsBounded`. Mathlib's
own statement is {name}`Metric.isCompact_iff_isClosed_bounded`; this one is proved from
Robinson's criterion. -/
theorem isCompact_iff_isClosed_and_isBounded_by_halos :
    IsCompact B ↔ IsClosed B ∧ Bornology.IsBounded B := by
  rw [isCompact_iff_isClosed_and_bounded, isBounded_iff_forall_norm_le]
  simp only [Real.norm_eq_abs]

/-- **Exercise 10.3.2, for Robinson's condition.** A closed subset $`C` of a set $`B`
satisfying Robinson's condition satisfies it too: a point of $`{}^*C \subseteq {}^*B` is
infinitely close to some $`r \in B`, and $`r \in C` because $`C` is closed. -/
theorem RobinsonCompact.of_isClosed_subset (hB : RobinsonCompact B) (hC : IsClosed C)
    (h : C ⊆ B) : RobinsonCompact C := by
  intro x hx
  obtain ⟨r, -, hxr⟩ := hB x (starSet_mono (αS := ℝ*) h hx)
  exact ⟨r, isClosed_iff_forall_infClose.1 hC r x hx hxr.symm, hxr⟩

/-- **Exercise 10.3.2.** In the real line, a closed subset of a compact set is compact. -/
theorem isCompact_of_isClosed_subset_by_halos (hB : IsCompact B) (hC : IsClosed C)
    (h : C ⊆ B) : IsCompact C :=
  (hB.robinsonCompact.of_isClosed_subset hC h).isCompact

end Compactness

/-!
## 10.4 Compactness and (Uniform) Continuity

Two classical theorems about continuous functions on compact sets have one-line proofs from
Robinson's criterion and the infinitesimal characterisations of continuity (Theorem 7.1.3)
and uniform continuity (Theorem 7.7.1). The second explains Theorem 7.7.2, where the compact
set was a closed bounded interval.
-/

section CompactContinuity

variable {B : Set ℝ} {f : ℝ → ℝ}

/-- **Theorem 10.4.1, for Robinson's condition.** If $`f` is continuous on $`B` and $`B`
satisfies Robinson's condition then so does $`f[B]`. A point of $`{}^*(f[B])` is
$`{}^*f(x)` for some $`x \in {}^*B`; this $`x` is infinitely close to some $`r \in B`, and
by continuity $`{}^*f(x) \simeq f(r) \in f[B]`. -/
theorem RobinsonCompact.image (hB : RobinsonCompact B) (hf : ContinuousOn f B) :
    RobinsonCompact (f '' B) := by
  intro y hy
  rw [starSet_image] at hy
  obtain ⟨x, hx, rfl⟩ := hy
  obtain ⟨r, hr, hxr⟩ := hB x hx
  exact ⟨f r, mem_image_of_mem f hr, continuousOn_iff_infClose.1 hf r hr x hx hxr⟩

/-- **Theorem 10.4.1.** The continuous image of a compact set is compact. Mathlib's statement
is {name}`IsCompact.image_of_continuousOn`; the proof here is by Robinson's criterion. -/
theorem isCompact_image_by_halos (hB : IsCompact B) (hf : ContinuousOn f B) :
    IsCompact (f '' B) :=
  (hB.robinsonCompact.image hf).isCompact

/-- **Theorem 10.4.2, for Robinson's condition.** A function continuous on a set $`B`
satisfying Robinson's condition is uniformly continuous on $`B`. If $`x \simeq y` in
$`{}^*B`, then $`x` and $`y` are infinitely close to the same $`r \in B`, and continuity at
$`r` gives $`{}^*f(x) \simeq f(r) \simeq {}^*f(y)`. -/
theorem RobinsonCompact.uniformContinuousOn (hB : RobinsonCompact B) (hf : ContinuousOn f B) :
    UniformContinuousOn f B := by
  rw [uniformContinuousOn_iff_infClose]
  intro x hx y hy hxy
  obtain ⟨r, hr, hxr⟩ := hB x hx
  have hyr : y ≊ (r : ℝ*) := hxy.symm.trans hxr
  rw [continuousOn_iff_infClose] at hf
  exact (hf r hr x hx hxr).trans (hf r hr y hy hyr).symm

/-- **Theorem 10.4.2.** A function that is continuous on a compact set of real numbers is
uniformly continuous on it. Mathlib's statement is
{name}`IsCompact.uniformContinuousOn_of_continuous`; the proof here is by Robinson's
criterion. -/
theorem uniformContinuousOn_of_isCompact_by_halos (hB : IsCompact B) (hf : ContinuousOn f B) :
    UniformContinuousOn f B :=
  hB.robinsonCompact.uniformContinuousOn hf

end CompactContinuity

end Goldblatt
